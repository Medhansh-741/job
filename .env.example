# Copy to `.env` at the repo root (and keep apps/api/.env identical if you use one).
# The API loads the repo-root .env first; python-dotenv never overrides a variable that is already set,
# so two copies with different values will silently disagree. Keep them in sync.

# --- Supabase (required) -----------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co       # required, no default (the API refuses to start without it)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # backend only: private Storage bucket access
SUPABASE_JWT_SECRET=your-jwt-secret                    # only needed for HS256-signed tokens (ES256/RS256 use the JWKS endpoint)
SUPABASE_ANON_KEY=your-anon-key                        # only used by the verification scripts in /scripts
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# --- Groq (LLM explanations) ---------------------------------------------------------------------
# Rate limits are per ORGANIZATION. Two keys only add capacity if they belong to different orgs.
GROQ_API_KEY=gsk_your_main_key
GROQ_API_KEY_FALLBACK=gsk_key_from_a_different_org     # optional
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_RPM=25            # local limiter, per key (free tier allows 30)
# GROQ_TPM=6500          # local limiter, per key (free tier allows 8000)
# GROQ_TIMEOUT=20
# GROQ_REASONING_EFFORT=low
# GROQ_INCLUDE_REASONING=false
# GROQ_MAX_INFLIGHT=2

# --- CORS (optional) -------------------------------------------------------------------------------
# Browsers reach the API only through the Next.js proxy, so the default (local dev origins) is normally enough.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Live job-search fallback (optional) -----------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=            # US searches
JOOBLE_API_KEY_IN=         # India searches

# --- Web app: put these in apps/web/.env.local (Next.js does not read the repo-root .env) -----------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# FASTAPI_BACKEND_URL=http://127.0.0.1:8000
